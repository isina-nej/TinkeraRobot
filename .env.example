# Django
DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# Set DEBUG=false in production.
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Tehran
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000

# SQLite defaults work without these database variables.
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=group_bot
# DB_USER=group_bot
# DB_PASSWORD=replace-me
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Telegram
BOT_TOKEN=replace-with-botfather-token
# Optional: comma/space-separated tokens. BOT_TOKEN remains backward-compatible.
# BOT_TOKENS=first-botfather-token,second-botfather-token
BOT_USERNAME=NuyaRobot
ADMIN_IDS=123456789
TARGET_CHAT_ID=@your_required_channel

# AI service
AI_API_URL=https://ai.tinkera.org/api/chat
PROMPT_URL_PREFIX=https://ai.tinkera.org/chat/
NOYA_API_URL=http://127.0.0.1:20128/v1/chat/completions
NOYA_API_KEY=replace-with-9router-api-key
NOYA_MODEL=TinkeraBot
# Noya knows these Telegram user IDs as her creator (defaults to ADMIN_IDS).
NOYA_CREATOR_IDS=
NOYA_CREATOR_NAME=ادی
# Optional comma-separated aliases people might use when talking about the creator.
NOYA_CREATOR_ALIASES=
NOYA_SYSTEM_PROMPT_ENABLED=true

# Admin agent (natural-language admin assistant)
# Master switch for the /agent, /adminai and "نویا،" admin triggers.
AGENT_ENABLED=true
# When true, commands the deterministic parser cannot classify are sent to the
# AI for strict JSON structured output. When false, only deterministic parsing
# is used (no AI calls for admin commands).
AGENT_AI_ENABLED=true
# Optional override for the agent model; falls back to NOYA_MODEL when empty.
AGENT_MODEL=
# Glass-key confirmation time-to-live (seconds) for sensitive operations.
AGENT_CONFIRMATION_TTL_SECONDS=120
# Minimum AI confidence required to act on an AI-parsed command.
AGENT_MIN_CONFIDENCE=0.80
# Maximum accepted admin command length (characters).
AGENT_MAX_COMMAND_LENGTH=2000
# ReAct harness: multi-step investigate (read tools + sandboxed Python on data).
AGENT_HARNESS_ENABLED=true
# When false, harness still runs a deterministic read-tool pass (no LLM planner).
AGENT_HARNESS_AI_ENABLED=true
AGENT_HARNESS_MAX_STEPS=5
# Message archive (opt-in). Only archives messages the bot receives and records
# deletions the bot itself performs. Telegram gives no public event for manual
# deletions in ordinary groups.
MESSAGE_ARCHIVE_ENABLED=false
MESSAGE_ARCHIVE_RETENTION_DAYS=30

# Independent test bot (for live testing WITHOUT touching production @NuyaRobot).
# `manage.py run_testbot` uses ONLY TEST_BOT_TOKEN and never falls back to
# BOT_TOKEN. Create a separate bot in BotFather for this.
TEST_BOT_TOKEN=
TEST_GROUP_ID=
TEST_ADMIN_USER_ID=

# Memory core (phase 1)
SHORT_TERM_TTL_HOURS=24
MEDIUM_TERM_TTL_DAYS=14
LONG_TERM_TTL_DAYS=60
MEMORY_MAX_CONTEXT_TOKENS=600
# Cap active MemoryItem rows per (user, scope/conversation). Oldest non-critical
# items are soft-deleted when the cap is exceeded.
MEMORY_MAX_ITEMS_PER_SCOPE=200
MEMORY_EXTRACTION_ENABLED=true
MEMORY_RETRIEVAL_ENABLED=true
MEMORY_INGESTION_ENABLED=true
MEMORY_USER_COMMANDS_ENABLED=true
MEMORY_FAIL_OPEN=true
MEMORY_LATENCY_LOGGING_ENABLED=false
